# Database (required)
DATABASE_URL="postgresql://finguard:finguard_secret_change_in_prod@localhost:5432/finguard"

# Optional: Redis (for rate limiting / sessions if using with-redis profile)
REDIS_URL="redis://localhost:6379"

# Session (change in production)
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
SESSION_MAX_AGE_SECONDS=86400

# Auth
CSRF_SECRET="change-me-csrf-secret-min-32-chars"
COOKIE_PREFIX="finguard"

# Admin secrets (required in production for /admin/settings)
# 32-byte key as 64-char hex or 44-char base64. If not hex/base64, used as passphrase for key derivation.
SECRETS_ENCRYPTION_KEY=

# API / LLM (fallback when Admin-stored keys are not set)
# Admin Settings page stores keys encrypted in DB; these env vars are used only if DB secret is not set.
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
LAKERA_GUARD_API_KEY=""
LAKERA_API_KEY=""
LAKERA_PROJECT_ID=""
RAG_ENABLED=false
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Chat provider: openai | anthropic (required key must be set or chat returns maintenance message)
CHAT_PROVIDER=openai
# When true, Lakera key + LAKERA_PROJECT_ID required even if security mode off
# REQUIRE_LAKERA_ALWAYS=false
CHAT_MODEL_OPENAI=gpt-4o-mini
CHAT_MODEL_ANTHROPIC=claude-3-5-sonnet-20241022

# Limits (secure defaults)
MAX_REQUEST_BODY_BYTES=65536
MAX_CHAT_MESSAGE_LENGTH=4096
MAX_FILE_UPLOAD_BYTES=10485760
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Chat security thresholds: low | medium | high | critical
# Lakera v2 scans every chat prompt; malicious content is blocked (no tools, no model).
CHAT_BLOCK_THRESHOLD=high
CHAT_SAFE_REWRITE_THRESHOLD=medium

# Identity verification (simulation): SSN last 4 is hashed at rest; never store full SSN.
# Users set last 4 in Profile; chat requires it for sensitive (balance/transactions) answers.

# File upload / RAG
UPLOAD_DIR=/opt/finguard/data/uploads
RAG_AUTO_APPROVE_LOW_MED=false

# App (dev server runs on port 5000)
NEXT_PUBLIC_APP_URL=http://localhost:5000
APP_BASE_URL=http://localhost:5000

# Demo finance pipeline: when true, dashboard/chat read balances/transactions from SQLite (data/db/app.sqlite) when session email matches a demo user. Run db:init and import:finance first.
# USE_DEMO_FINANCE_DATA=false

# Optional: used only if you integrate NextAuth; this app uses custom session auth
# NEXTAUTH_URL=http://localhost:5000
# NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars
